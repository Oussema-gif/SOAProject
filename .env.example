DB_HOST=localhost
DB_PORT=5432
DB_NAME=soa_project

# PostgreSQL superuser, used only by the container
POSTGRES_ADMIN_USER=soa_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# Per-service DB roles (names are fixed by the init script)
MAINTENANCE_DB_USER=maintenance_app
MAINTENANCE_DB_PASSWORD=change-me-maintenance
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=change-me-inventory
# --- SOAP Inventory service API key (POST /services/inventory) ---
# Generate:  openssl rand -hex 32
INVENTORY_API_KEY=REPLACE_WITH_openssl_rand_hex_32
